# 息壤生产环境变量
# 复制为 .env 并填写真实值：cp .env.example .env

# ══════════════════════════════════════════
# LLM（必填）
# ══════════════════════════════════════════
XIRANG_API_KEY=sk-your-api-key-here
XIRANG_BASE_URL=https://api.openai.com/v1
XIRANG_MODEL=gpt-4o

# ══════════════════════════════════════════
# 安全（必填）
# ══════════════════════════════════════════
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
XIRANG_JWT_SECRET=your-fixed-jwt-secret-min-32-chars-here

# ══════════════════════════════════════════
# 数据库（必填）
# ══════════════════════════════════════════
POSTGRES_PASSWORD=your_strong_db_password_here
XIRANG_USE_POSTGRES=true
XIRANG_USE_REDIS=true

# ══════════════════════════════════════════
# CORS（生产填写真实域名，多个用逗号分隔）
# ══════════════════════════════════════════
XIRANG_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# 生产示例：XIRANG_CORS_ORIGINS=https://xirang.ai,https://www.xirang.ai

# ══════════════════════════════════════════
# 短信（SMS_SANDBOX=false 时必填）
# ══════════════════════════════════════════
XIRANG_SMS_SANDBOX=true
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
XIRANG_SMS_SIGN_NAME=息壤历史
XIRANG_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# ══════════════════════════════════════════
# 支付（PAYMENT_SANDBOX=false 时必填）
# ══════════════════════════════════════════
XIRANG_PAYMENT_SANDBOX=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ══════════════════════════════════════════
# 可选调整
# ══════════════════════════════════════════
XIRANG_ENV=prod
XIRANG_FREE_QUOTA=3
XIRANG_AUTH_ENABLED=true
XIRANG_RATE_LIMIT=true
XIRANG_RATE_LIMIT_RPM=60
XIRANG_WORKERS=2
XIRANG_LOG_LEVEL=INFO
XIRANG_LOG_JSON=true
