# 息壤生产环境变量示例
# 复制为 .env 并填写真实值

# ── LLM（必填）────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
XIRANG_MODEL=gpt-4o

# ── 数据库（必填）─────────────────────────────────────────
DB_PASSWORD=your_strong_password_here
JWT_SECRET=your_jwt_secret_min_32_chars_here

# ── 短信（SMS_SANDBOX=false 时必填）──────────────────────
SMS_SANDBOX=true
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ── 支付（PAYMENT_SANDBOX=false 时必填）──────────────────
PAYMENT_SANDBOX=true
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ── 可选调整 ──────────────────────────────────────────────
XIRANG_FREE_QUOTA=3

# ── 跨域（生产填写真实域名，多个用逗号分隔）────────────────
XIRANG_CORS_ORIGINS=https://xirang.ai,https://www.xirang.ai
