# .env.example
# 息壤生产环境变量模板
# 复制为 .env 并填写真实值（.env 已加入 .gitignore，不要提交）
# 用法：cp .env.example .env && vim .env

# ══ LLM 配置（必填）══════════════════════════════════════════
XIRANG_API_KEY=sk-your-api-key-here
XIRANG_BASE_URL=https://api.openai.com/v1
# 如使用国内兼容接口（如 DeepSeek / 阿里百炼）：
# XIRANG_BASE_URL=https://api.deepseek.com/v1
XIRANG_MODEL=gpt-4o-mini

# ══ 环境标识 ════════════════════════════════════════════════
# dev / staging / prod
XIRANG_ENV=prod

# ══ 数据目录 ════════════════════════════════════════════════
# Docker 部署时映射到容器内 /data
XIRANG_DATA_DIR=/data

# ══ Redis（会话持久化 & 限流）══════════════════════════════
XIRANG_REDIS_URL=redis://redis:6379/0
XIRANG_USE_REDIS=true

# ══ PostgreSQL（用户档案持久化）══════════════════════════
XIRANG_DB_URL=postgresql://xirang:your-pg-password@postgres:5432/xirang
XIRANG_USE_POSTGRES=true
POSTGRES_PASSWORD=your-pg-password-here

# ══ JWT 鉴权 ════════════════════════════════════════════════
# 生产必须设置强随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
XIRANG_JWT_SECRET=replace-with-64-char-random-hex-string
XIRANG_JWT_EXPIRE=10080          # token 有效期（分钟），默认7天
XIRANG_AUTH_ENABLED=false        # true=开启鉴权，false=开发透传
# 静态 API Keys（逗号分隔，用于服务端集成）
# XIRANG_API_KEYS=key1,key2,key3

# ══ 限流 ════════════════════════════════════════════════════
XIRANG_RATE_LIMIT=true
XIRANG_RATE_LIMIT_RPM=60         # 每用户每分钟最大请求数

# ══ 会话管理 ════════════════════════════════════════════════
XIRANG_SESSION_TTL=7200          # 会话存活时间（秒），默认2小时
XIRANG_MAX_SESSIONS=200          # 最大活跃会话数

# ══ 可观测性 ════════════════════════════════════════════════
XIRANG_METRICS=true              # 开启 Prometheus /metrics 端点
XIRANG_LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
XIRANG_LOG_JSON=true             # true=JSON 结构化日志（生产推荐）

# ══ 服务器 ══════════════════════════════════════════════════
XIRANG_HOST=0.0.0.0
XIRANG_PORT=8000
XIRANG_WORKERS=2                 # Gunicorn worker 数，建议 = CPU核心数

# ══ Grafana ════════════════════════════════════════════════
GRAFANA_PASSWORD=your-grafana-admin-password
